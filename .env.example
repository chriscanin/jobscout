# ── Crawler (apps/crawler/.env) ──────────────────────────────────────────────

# Direct/session-mode Postgres connection string (port 5432, not transaction pooler)
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# LLM provider for classification: "lmstudio" (default, local + free) or "anthropic".
LLM_PROVIDER=lmstudio

# LM Studio (local, OpenAI-compatible). Used when LLM_PROVIDER=lmstudio (the default).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=qwen2.5-32b-instruct

# Anthropic API key — OPTIONAL, only needed when LLM_PROVIDER=anthropic
# (haiku default, sonnet for ambiguous). Leave unset to run fully local/free.
ANTHROPIC_API_KEY=sk-ant-...

# Discord incoming webhook URL for new-match notifications
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>

# ── Admin (Vercel env vars) ───────────────────────────────────────────────────
# @auth0/nextjs-auth0 v4 env var names (v3 used AUTH0_BASE_URL / AUTH0_ISSUER_BASE_URL —
# those are no longer correct; v4 requires AUTH0_DOMAIN and APP_BASE_URL).

# Postgres connection string (transaction pooler is fine for the admin)
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Auth0 tenant domain (just the hostname, e.g. dev-xxxx.us.auth0.com — no https://)
AUTH0_DOMAIN=<tenant>.us.auth0.com

# Auth0 application client ID
AUTH0_CLIENT_ID=<your-auth0-client-id>

# Auth0 application client secret
AUTH0_CLIENT_SECRET=<your-auth0-client-secret>

# Session encryption key — any random string of at least 32 characters
# Generate with: openssl rand -hex 32
AUTH0_SECRET=replace-with-a-long-random-string

# The full base URL of the deployed admin app (no trailing slash)
APP_BASE_URL=https://jobscout-admin.vercel.app

# Comma-separated list of email addresses allowed to log in to admin
ADMIN_ALLOWED_EMAILS=admin@superapps.com
