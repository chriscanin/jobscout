{
  "name": "jobscout",
  "private": true,
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "lint": "eslint .",
    "crawl": "pnpm -C apps/crawler crawl",
    "loop": "pnpm -C apps/crawler loop",
    "discover": "pnpm -C apps/crawler discover",
    "doctor": "pnpm -C apps/crawler doctor",
    "db:push": "pnpm -C apps/crawler db:push",
    "e2e": "pnpm -C apps/crawler e2e"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "~5.6.3",
    "vitest": "~2.1.8"
  }
}
